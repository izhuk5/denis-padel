---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { sections } from "../../data/schema.js";
import { listGroup } from "../../lib/repositories/admin.js";

/* Rendered per request so the session guard in src/middleware.js actually
   runs — a prerendered page is public by definition. */
export const prerender = false;

/* Russian needs three forms: 1 запись, 3 записи, 5 записей — and 11–14 take
   the "many" form even though they end in 1–4. */
function records(n) {
  const mod10 = n % 10;
  const mod100 = n % 100;

  if (mod10 === 1 && mod100 !== 11) return `${n} запись`;
  if (mod10 >= 2 && mod10 <= 4 && (mod100 < 12 || mod100 > 14)) return `${n} записи`;
  return `${n} записей`;
}

/* How many records each page holds, so the dashboard says something useful
   rather than just repeating the nav. A failed count shows a dash instead of
   breaking the whole dashboard. */
const counts = Object.fromEntries(
  await Promise.all(
    sections.map(async (section) => {
      try {
        const listGroups = section.groups.filter((group) => group.kind === "list");

        /* A page made only of single blocks (SEO) has no list to count —
           showing "0" there would read as "nothing filled in". */
        if (!listGroups.length) return [section.key, undefined];

        const lists = await Promise.all(listGroups.map((group) => listGroup(group.key)));
        return [section.key, lists.reduce((sum, list) => sum + list.length, 0)];
      } catch {
        return [section.key, null];
      }
    }),
  ),
);
---

<AdminLayout title="Обзор">
  <div class="admin-cards">
    {
      sections.map((section) => (
        <a class="admin-card" href={`/admin/${section.key}`}>
          <h2 class="admin-card-title">{section.label}</h2>
          <p class="admin-card-hint">{section.hint}</p>
          {counts[section.key] !== undefined && (
            <span class="admin-card-count">
              {counts[section.key] === null ? "—" : records(counts[section.key])}
            </span>
          )}
        </a>
      ))
    }
  </div>

  <div class="admin-note">
    <h2>Как изменения попадают на сайт</h2>
    <ol>
      <li>Правите запись — она сохраняется в базу автоматически.</li>
      <li>Нажимаете «Опубликовать» — сайт пересобирается.</li>
      <li>Через 1–2 минуты изменения видны на сайте.</li>
    </ol>
    <p>Черновики (переключатель «Опубликовано» выключен) на сайт не попадают.</p>
  </div>
</AdminLayout>
