---
import "../styles/admin.css";
import { sections } from "../data/schema.js";
import { listGroup } from "../lib/repositories/admin.js";

const { section = null, title } = Astro.props;

const active = sections.find((item) => item.key === section) ?? null;

/* Every group on this page is loaded server-side, through the privileged
   client, so drafts show up here even though the public site cannot see
   them. A failure (most likely a missing secret key) is shown on the page
   rather than crashing it, so the owner sees what to fix. */
let data = null;
let loadError = null;

if (active) {
  try {
    const entries = await Promise.all(
      active.groups.map(async (group) => [group.key, await listGroup(group.key)]),
    );
    data = Object.fromEntries(entries);

    /* A photo's category dropdown needs the category list even when this
       page is not the one that edits categories. */
    for (const group of active.groups) {
      for (const field of group.fields) {
        if (field.type === "select" && !(field.optionsFrom in data)) {
          data[field.optionsFrom] = await listGroup(field.optionsFrom);
        }
      }
    }
  } catch (error) {
    loadError = error.message;
  }
}

/* Serialised for the client script. `<` is escaped so no string in the
   content can close this script tag early. */
const payload = JSON.stringify({ sectionKey: section, data }).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Админка Alicante Paddle</title>

    <!-- The admin is a private tool, not a page anyone should reach from
         search. robots.txt blocks crawling; this blocks indexing if a link
         to it ever leaks. -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body class="admin">
    <a class="admin-skip" href="#admin-main">К содержимому</a>

    <div class="admin-shell">
      <aside class="admin-sidebar">
        <a class="admin-brand" href="/admin">
          <span class="admin-brand-mark">AP</span>
          <span class="admin-brand-text">Админка</span>
        </a>

        <nav class="admin-nav" aria-label="Разделы">
          {
            sections.map((item) => (
              <a
                class:list={["admin-nav-link", { "is-active": item.key === section }]}
                href={`/admin/${item.key}`}
                aria-current={item.key === section ? "page" : undefined}
              >
                <span>{item.label}</span>
              </a>
            ))
          }
        </nav>

        <div class="admin-sidebar-foot">
          <a class="admin-sidebar-link" href="/" target="_blank" rel="noreferrer">
            Открыть сайт ↗
          </a>

          <!-- A form, not a link: logging out changes state, and a GET link
               would fire from any image tag on another site. -->
          <form method="POST" action="/admin/logout">
            <button type="submit" class="admin-sidebar-link admin-logout">Выйти</button>
          </form>
        </div>
      </aside>

      <div class="admin-main-col">
        <header class="admin-topbar">
          <div class="admin-topbar-text">
            <h1 class="admin-title">{active ? active.label : title}</h1>
            {active?.hint && <p class="admin-hint">{active.hint}</p>}
          </div>

          <div class="admin-actions">
            <button type="button" class="admin-btn admin-btn-primary" data-admin-publish>
              Опубликовать
            </button>
          </div>
        </header>

        <p class="admin-status" data-admin-status aria-live="polite"></p>

        <main class="admin-main" id="admin-main">
          {
            loadError ? (
              <div class="admin-error" role="alert">
                <h2>Не удалось загрузить данные</h2>
                <p>{loadError}</p>
              </div>
            ) : (
              <slot />
            )
          }
        </main>
      </div>
    </div>

    <script type="application/json" data-admin-payload set:html={payload}></script>

    <script>
      // @ts-nocheck — project is plain JS
      import { mountAdmin } from "../scripts/admin-app.js";
      import { sectionByKey } from "../data/schema.js";

      const root = document.getElementById("admin-root");
      const payload = JSON.parse(document.querySelector("[data-admin-payload]").textContent);

      if (root && payload.data) {
        mountAdmin({ root, section: sectionByKey(payload.sectionKey), data: payload.data });
      }
    </script>
  </body>
</html>
